# ==============================================================================
# NitiSetu Backend Environment Configuration (Template)
# ==============================================================================

APP_ENV=development
APP_NAME="NitiSetu API"
PORT=8000
FRONTEND_ORIGIN="http://localhost:5173"

# Supabase PostgreSQL Database (with pgvector)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Supabase API & Storage Configuration
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=nitisetu-user-documents

# Google Gemini API Configuration (Official google-genai SDK)
# Get from: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
